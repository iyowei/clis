{
  "id": "scan-default-exclude-install-tree",
  "specRefs": ["BC-36", "BC-09", "OF-12"],
  "fixture": {
    "projects": [
      { "dir": "zone/app" },
      { "dir": "zone/.npm/_npx/abc123" },
      { "dir": "zone/.vscode/extensions/some-ext" }
    ]
  },
  "setup": [
    {
      "write": {
        "path": "config.json",
        "text": "{\n  \"roots\": [\"$FIXTURE/zone\"]\n}\n"
      }
    }
  ],
  "run": {
    "env": { "SWEEP_NM_CONFIG": "$FIXTURE/config.json" }
  },
  "expect": {
    "exitCode": 0,
    "stdoutExact": "▍ SWEEP-NM  预览 · 1 个根: $FIXTURE/zone\n  ▒ 8 KB  app    $FIXTURE/zone/app\n  █ 合计 1 处 · 8 KB   加 --yes 执行删除\n",
    "stdoutMustNotContain": ["abc123", "some-ext"],
    "stderrMustNotContain": ["排除名未命中"]
  }
}
