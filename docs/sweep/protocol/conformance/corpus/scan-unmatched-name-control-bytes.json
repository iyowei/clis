{
  "id": "scan-unmatched-name-control-bytes",
  "specRefs": ["BC-09", "OF-12", "OF-14"],
  "fixture": {
    "projects": [{ "dir": "zone/a" }]
  },
  "setup": [
    {
      "write": {
        "path": "config.json",
        "text": "{\n  \"roots\": [\"$FIXTURE/zone\"],\n  \"exclude\": [\"nosuch\\u001b[2J\\nevil\\u202e\"]\n}\n"
      }
    }
  ],
  "run": {
    "env": { "SWEEP_NM_CONFIG": "$FIXTURE/config.json" }
  },
  "expect": {
    "exitCode": 0,
    "stdoutExact": "▍ SWEEP-NM  预览 · 1 个根: $FIXTURE/zone\n  ▒ 8 KB  a    $FIXTURE/zone/a\n  █ 合计 1 处 · 8 KB   加 --yes 执行删除\n",
    "stderrContains": [
      "排除名未命中任何已扫描的目录: nosuch[2J evil (按目录名精确匹配; 若其上层目录已被排除则属预期)"
    ],
    "stderrMustNotContain": ["\u001b", "\u202e"]
  }
}
