{
  "compilerOptions": {
    // bun / node 均可直跑 TS, 目标取保守基线
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    // 开发态解析: monorepo 内对 API 包的引用直指单源 src (零构建), 发布态由 API 包
    // package.json 的 exports 指向 dist; tsconfig paths 优先级高于 node_modules 解析
    // (bun 运行时 / tsc / bun build 三处已实测), 消费方项目无本配置不受影响
    "paths": {
      "@iyowei/sweep-node-modules": [
        "./packages/sweep-node-modules/src/index.ts"
      ],
      "@iyowei/sweep-node-modules/testing": [
        "./packages/sweep-node-modules/src/fixtures.ts"
      ],
      "@iyowei/codd": ["./packages/codd/src/index.ts"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["bun"]
  },
  // 排除派生生成物与目标项目模板空间 (同款排除见 .gitignore / .prettierignore / .oxlintrc.json / bunfig.toml)
  "exclude": [
    "scripts/transcription/mutants",
    "packages/create-clis/assets",
    "packages/create-clis/scripts/template-skeletons",
    "packages/codd/assets",
    "packages/codd/template",
    "packages/codd-cli/assets"
  ]
}
