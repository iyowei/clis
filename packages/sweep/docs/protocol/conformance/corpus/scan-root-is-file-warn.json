{
  "id": "scan-root-is-file-warn",
  "specRefs": ["BC-07", "OF-07"],
  "fixture": {},
  "setup": [
    {
      "write": {
        "path": "zone/note.txt",
        "text": "not a directory"
      }
    },
    {
      "write": {
        "path": "config.json",
        "text": "{\n  \"version\": 2,\n  \"roots\": [\n    \"$FIXTURE/zone/note.txt\"\n  ],\n  \"exclude\": [],\n  \"presets\": {\n    \"node\": {}\n  }\n}\n"
      }
    }
  ],
  "run": {
    "env": {
      "SWEEP_CONFIG": "$FIXTURE/config.json"
    }
  },
  "expect": {
    "exitCode": 0,
    "stdoutExact": "▍ SWEEP  预览 · 1 个根: $FIXTURE/zone/note.txt\n  ░ 未发现可清理目标\n",
    "stderrContains": ["根不是目录, 已跳过: $FIXTURE/zone/note.txt"]
  }
}
