{
  "id": "scan-unreadable-dir-control-bytes",
  "specRefs": ["BC-08", "OF-12", "OF-14"],
  "fixture": {
    "projects": [
      {
        "dir": "zone/a"
      }
    ],
    "unreadable": ["zone/locked\u001b[2Jevil"]
  },
  "setup": [
    {
      "write": {
        "path": "config.json",
        "text": "{\n  \"version\": 2,\n  \"roots\": [\n    \"$FIXTURE/zone\"\n  ],\n  \"exclude\": [],\n  \"presets\": {\n    \"node\": {}\n  }\n}\n"
      }
    }
  ],
  "run": {
    "env": {
      "SWEEP_CONFIG": "$FIXTURE/config.json"
    }
  },
  "expect": {
    "exitCode": 0,
    "stdoutExact": "▍ SWEEP  预览 · 1 个根: $FIXTURE/zone\n  ▒ 8 KB  a    $FIXTURE/zone/a\n  █ 合计 1 处 · 8 KB   加 --yes 执行删除\n",
    "stderrContains": ["目录不可读, 已跳过: $FIXTURE/zone/locked[2Jevil"],
    "stderrMustNotContain": ["\u001b"]
  }
}
