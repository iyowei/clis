{
  "id": "scan-include-unmatched-warn",
  "specRefs": ["BC-33", "OF-12"],
  "fixture": {
    "projects": [
      {
        "dir": "zone/keep"
      }
    ]
  },
  "setup": [
    {
      "write": {
        "path": "config.json",
        "text": "{\n  \"version\": 2,\n  \"roots\": [\n    \"$FIXTURE/zone\"\n  ],\n  \"include\": [\n    \"nosuch\"\n  ],\n  \"presets\": {\n    \"node\": {}\n  }\n}\n"
      }
    }
  ],
  "run": {
    "env": {
      "SWEEP_CONFIG": "$FIXTURE/config.json"
    }
  },
  "expect": {
    "exitCode": 0,
    "stdoutExact": "▍ SWEEP  预览 · 1 个根: $FIXTURE/zone\n  ░ 未发现可清理目标\n",
    "stdoutMustNotContain": ["keep"],
    "stderrContains": [
      "包含名未命中任何已扫描的目录: nosuch (按目录名精确匹配; 若其上层目录已被排除则属预期)",
      "包含名单无一条命中, 本次扫描必为空结果 (请核对名字与大小写; 若名字位于被排除的目录之下则属预期)"
    ]
  }
}
