    "fs": [
      {
        "path": "home/.config/sweep",
        "state": "exists",
        "kind": "dir",
        "globExists": "config.json.*.modified"
      },
      {
        "path": "home/.config/sweep/config.json",
        "state": "exists",
        "kind": "file",
        "contains": ["\"version\": 2", "\"node\""]
      }
    ]
  }
}
