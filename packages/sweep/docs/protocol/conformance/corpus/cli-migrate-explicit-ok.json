{
  "id": "cli-migrate-explicit-ok",
  "specRefs": ["BC-49", "BC-26"],
  "fixture": {},
  "setup": [
    {
      "write": {
        "path": "home/.config/sweep/config.json",
        "text": "{\n  \"roots\": [\"$FIXTURE/zone\"]\n}\n"
      }
    }
  ],
  "run": {
    "argv": ["migrate"]
