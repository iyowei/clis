{
  "id": "scan-root-eacces-warn",
  "specRefs": ["BC-07", "OF-07"],
  "fixture": {
    "projects": [
      {
        "dir": "zone/locked/inner"
      }
    ],
    "unreadable": ["zone/locked"]
  },
  "setup": [
    {
      "write": {
        "path": "config.json",
        "text": "{\n  \"version\": 2,\n  \"roots\": [\n    \"$FIXTURE/zone/locked/inner\"\n  ],\n  \"exclude\": [],\n  \"presets\": {\n    \"node\": {}\n  }\n}\n"
      }
    }
  ],
  "run": {
    "env": {
      "SWEEP_CONFIG": "$FIXTURE/config.json"
    }
  },
  "expect": {
    "exitCode": 0,
    "stdoutExact": "▍ SWEEP  预览 · 1 个根: $FIXTURE/zone/locked/inner\n  ░ 未发现可清理目标\n",
    "stderrContains": [
      "根不可读 (权限不足), 已跳过: $FIXTURE/zone/locked/inner"
    ]
  }
}
