{
  "id": "scan-ancestor-excluded-unmatched-warn",
  "specRefs": ["BC-32", "BC-33", "OF-12"],
  "fixture": {
    "projects": [
      {
        "dir": "container/deep/proj"
      }
    ]
  },
  "setup": [
    {
      "write": {
        "path": "config.json",
        "text": "{\n  \"version\": 2,\n  \"roots\": [\n    \"$FIXTURE\"\n  ],\n  \"exclude\": [\n    \"container\"\n  ],\n  \"include\": [\n    \"deep\"\n  ],\n  \"presets\": {\n    \"node\": {}\n  }\n}\n"
      }
    }
  ],
  "run": {
    "env": {
      "SWEEP_CONFIG": "$FIXTURE/config.json"
    }
  },
  "expect": {
    "exitCode": 0,
    "stdoutExact": "▍ SWEEP  预览 · 1 个根: $FIXTURE\n  ░ 未发现可清理目标\n",
    "stderrContains": [
      "包含名未命中任何已扫描的目录: deep (按目录名精确匹配; 若其上层目录已被排除则属预期)"
    ],
    "stderrMustNotContain": ["未匹配到任何目录", "名字不存在"]
  }
}
