{
  "id": "render-path-tilde",
  "tags": ["apfs-block-size"],
  "specRefs": ["OF-01", "OF-03"],
  "fixture": {
    "projects": [
      {
        "dir": "home/proj"
      }
    ]
  },
  "setup": [
    {
      "write": {
        "path": "config.json",
        "text": "{\n  \"version\": 2,\n  \"roots\": [\n    \"$FIXTURE/home\"\n  ],\n  \"exclude\": [],\n  \"presets\": {\n    \"node\": {}\n  }\n}\n"
      }
    }
  ],
  "run": {
    "env": {
      "SWEEP_CONFIG": "$FIXTURE/config.json"
    }
  },
  "expect": {
    "exitCode": 0,
    "stdoutExact": "▍ SWEEP  预览 · 1 个根: ~\n  ▒ 8 KB  proj    ~/proj\n  █ 合计 1 处 · 8 KB   加 --yes 执行删除\n"
  }
}
