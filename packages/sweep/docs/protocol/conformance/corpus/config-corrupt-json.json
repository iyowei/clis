{
  "id": "config-corrupt-json",
  "specRefs": ["BC-19", "BC-26"],
  "fixture": {},
  "setup": [
    {
      "write": {
        "path": "config.json",
        "text": "{ this is not valid json"
      }
    }
  ],
  "run": {
    "env": {
      "SWEEP_CONFIG": "$FIXTURE/config.json"
    }
  },
  "expect": {
    "exitCode": 1,
    "stdoutExact": "",
    "stderrContains": ["配置损坏 ($FIXTURE/config.json)", "不是合法 JSON"]
  }
}
