{
  "name": "@iyowei/sweep-node-modules",
  "version": "0.5.1",
  "description": "Programmable API to sweep node_modules across workspace roots: scan, measure, and safely remove them from your own scripts and tools. 工作区级 node_modules 清理能力的可编程 API。",
  "author": "iTonyYo (https://github.com/iTonyYo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyowei/clis.git"
  },
  "homepage": "https://github.com/iyowei/clis#readme",
  "bugs": {
    "url": "https://github.com/iyowei/clis/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify:release": "bun scripts/verify-release.ts",
    "prepublishOnly": "npm run build && npm run verify:release"
  }
}
