{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*smoke.ts",
    "src/delete-review.ts",
    "src/fixtures.ts",
    "src/runtime.ts",
    "src/scan-native.ts",
    "src/scan-prune.ts",
    "src/size-du-parse.ts",
    "src/stale.ts"
  ]
}
