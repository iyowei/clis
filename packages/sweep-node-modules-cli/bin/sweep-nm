#!/bin/sh
# sweep-nm 启动器: 挑选运行时 (Bun 优先, 其次 Node) 后 exec 真实入口。
# 经 ~/.local/bin/sweep-nm 软链调用; 循环 readlink 解析多级符号链接 (BSD / GNU 皆可)。
# 选中 Bun 时强制附加 --config="$root/bin/bunfig.toml" --no-env-file, 隔绝被扫目录的
# bunfig.toml (preload / 损坏语法) 与 .env 环境变量污染。

target=$0
while [ -L "$target" ]; do
  link=$(readlink "$target" 2>/dev/null) || break
  case "$link" in
    /*) target=$link ;;
    *) target="$(dirname "$target")/$link" ;;
  esac
done
root=$(cd "$(dirname "$target")/.." && pwd)

if command -v bun >/dev/null 2>&1; then
  exec bun --config="$root/bin/bunfig.toml" --no-env-file "$root/src/cli.ts" "$@"
fi

if command -v node >/dev/null 2>&1; then
  exec node "$root/src/cli.ts" "$@"
fi

echo "sweep-nm: 未找到 bun 或 node, 请至少安装其一" >&2
exit 1
