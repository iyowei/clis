{
  "name": "@iyowei/sweep-node-modules-cli",
  "version": "0.1.0",
  "description": "CLI to find and delete node_modules across projects: scan multiple workspace roots (monorepo friendly), bulk-remove them to free up disk space, preview first and delete after confirmation. 工作区级 node_modules 批量清理工具。",
  "keywords": [
    "cli",
    "cli-tool",
    "tool",
    "node-modules",
    "node_modules",
    "modules",
    "delete",
    "remove",
    "remover",
    "del",
    "cleaner",
    "cleanup",
    "clean",
    "prune",
    "sweep",
    "bulk",
    "batch",
    "disk-usage",
    "disk-space",
    "free-up-space",
    "workspace",
    "monorepo",
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "node"
  ],
  "author": "iYoWei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyowei/sweep-node-modules.git"
  },
  "homepage": "https://github.com/iyowei/sweep-node-modules#readme",
  "bugs": {
    "url": "https://github.com/iyowei/sweep-node-modules/issues"
  },
  "type": "module",
  "bin": {
    "sweep-nm": "bin/sweep-nm.mjs"
  },
  "files": [
    "bin/sweep-nm.mjs",
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@iyowei/sweep-node-modules": "workspace:*"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile=dist/cli.js && bun scripts/write-dist-manifest.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  }
}
