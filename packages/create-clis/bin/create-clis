#!/bin/sh
# create-clis 启动器: 挑选运行时 (Bun 优先, 其次 Node) 后交给 npm 分发入口 (bin/create-clis.mjs)。
# 循环 readlink 解析多级符号链接 (BSD / GNU 皆可); 选中 Bun 时强制附加隔离配置。

target=$0
while [ -L "$target" ]; do
  link=$(readlink "$target" 2>/dev/null) || break
  case "$link" in
    /*) target=$link ;;
    *) target="$(dirname "$target")/$link" ;;
  esac
done
root=$(cd "$(dirname "$target")/.." && pwd)

if command -v bun >/dev/null 2>&1; then
  exec bun --config="$root/bin/bunfig.toml" --no-env-file "$root/bin/create-clis.mjs" "$@"
fi

if command -v node >/dev/null 2>&1; then
  exec node "$root/bin/create-clis.mjs" "$@"
fi

echo "create-clis: 未找到 bun 或 node, 请至少安装其一" >&2
exit 1
