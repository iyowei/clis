{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "assets/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.editorconfig",
        "$TURBO_ROOT$/.gitattributes",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/.nvmrc",
        "$TURBO_ROOT$/.prettierrc",
        "$TURBO_ROOT$/.releaserc.json",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/.vscode/extensions.json",
        "$TURBO_ROOT$/.vscode/settings.json",
        "$TURBO_ROOT$/.vscode/tasks.json",
        "$TURBO_ROOT$/CODE_OF_CONDUCT.md",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/docs/transcription/**",
        "$TURBO_ROOT$/lefthook.yml",
        "$TURBO_ROOT$/packages/sweep/LICENSE",
        "$TURBO_ROOT$/packages/sweep/scripts/verify-release.test.ts",
        "$TURBO_ROOT$/packages/sweep-cli/LICENSE",
        "$TURBO_ROOT$/packages/sweep-cli/tsconfig.json",
        "$TURBO_ROOT$/packages/sweep-cli/bin/**",
        "$TURBO_ROOT$/packages/sweep-cli/scripts/**",
        "$TURBO_ROOT$/scripts/**",
        "!$TURBO_ROOT$/scripts/transcription/mutants/**"
      ]
    }
  }
}
