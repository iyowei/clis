#!/bin/sh
# codd 启动器: 挑选运行时 (Bun 优先, 其次 Node) 后交给分发入口 (bin/codd.mjs)。
# 支持经 ~/.local/bin/codd 软链调用; 显式固定 --config 与 --no-env-file 防用户工作目录坏 bunfig.toml 或 .env 干扰。

target=$(readlink "$0" 2>/dev/null)
case "$target" in
  "") target=$0 ;;
  /*) ;;
  *) target="$(dirname "$0")/$target" ;;
esac
root=$(cd "$(dirname "$target")/.." && pwd)

if command -v bun >/dev/null 2>&1; then
  exec bun --config="$root/assets/template/podman/bunfig.toml" --no-env-file "$root/bin/codd.mjs" "$@"
fi

if command -v node >/dev/null 2>&1; then
  exec node "$root/bin/codd.mjs" "$@"
fi

echo "codd: 未找到 bun 或 node, 请至少安装其一" >&2
exit 1
