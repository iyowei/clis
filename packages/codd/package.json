{
  "name": "@iyowei/codd",
  "version": "1.0.0",
  "private": true,
  "description": "Programmable API and template assets for MongoDB 9.0 provisioning on Podman (Linux / macOS) and Kubernetes (Helm): deterministic hardware sizing formulas and 100% collision-free fingerprint isolation. 模板化 MongoDB 9.0 部署装配可编程 API 与模板资产包。",
  "keywords": [
    "mongodb",
    "mongo",
    "podman",
    "podman-compose",
    "kubernetes",
    "helm",
    "replica-set",
    "wiredtiger",
    "devops",
    "provisioning",
    "generator"
  ],
  "author": "iTonyYo (https://github.com/iTonyYo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyowei/clis.git"
  },
  "homepage": "https://github.com/iyowei/clis#readme",
  "bugs": {
    "url": "https://github.com/iyowei/clis/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun scripts/build-assets.ts && bun scripts/build.ts",
    "prepublishOnly": "npm run build && npm run verify:release",
    "verify:release": "bun scripts/verify-release.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src scripts"
  }
}
