#!/usr/bin/env bash
set -euo pipefail
{{SECRET_NOTICE}}
kubectl create namespace "{{NAMESPACE}}" --dry-run=client -o yaml | kubectl apply -f -
kubectl apply -f - <<'EOF'
apiVersion: v1
kind: Secret
metadata:
  name: "{{SECRET_NAME}}"
  namespace: "{{NAMESPACE}}"
type: Opaque
stringData:
  root-password: "{{ROOT_PASSWORD}}"
  app-password: "{{APP_PASSWORD}}"
  backup-password: "{{BACKUP_PASSWORD}}"
  extra-apps: "{{EXTRA_APPS}}"
  mongodb-keyfile: "{{KEY_FILE}}"
EOF
