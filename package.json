{
  "name": "clis",
  "private": true,
  "packageManager": "bun@1.4.5",
  "author": "iTonyYo (https://github.com/iTonyYo)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "safe-install": "bun scripts/safe-install.ts",
    "prepare": "node scripts/install-git-hooks.mjs || exit 0",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && bun check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "bun fmt",
    "format-check": "bun fmt --check",
    "test": "turbo run test && bun test scripts/",
    "bench": "turbo run bench",
    "conformance": "bun scripts/transcription/run-conformance.ts",
    "fuzz": "bun scripts/transcription/run-diff-fuzz.ts",
    "fuzz:diff": "bun scripts/transcription/run-diff-fuzz.ts --api-target \"node scripts/transcription/api-harness.ts\"",
    "ci": "bun scripts/ci.ts"
  },
  "devDependencies": {
    "@lidofinance/multi-semantic-release": "1.0.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/bun": "1.4.4",
    "oxlint": "1.85.0",
    "semantic-release": "25.0.9",
    "turbo": "2.11.5",
    "typescript": "7.0.2"
  }
}
