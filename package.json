{
  "name": "sweep-node-modules",
  "version": "0.4.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "description": "CLI tool to find and delete node_modules across projects: scan multiple workspace roots (monorepo friendly), bulk-remove them to free up disk space, preview first and delete after confirmation. 工作区级 node_modules 批量清理工具。",
  "keywords": [
    "cli",
    "cli-tool",
    "tool",
    "node-modules",
    "node_modules",
    "modules",
    "delete",
    "remove",
    "remover",
    "del",
    "cleaner",
    "cleanup",
    "clean",
    "prune",
    "sweep",
    "bulk",
    "batch",
    "disk-usage",
    "disk-space",
    "free-up-space",
    "workspace",
    "monorepo",
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "node"
  ],
  "author": "iYoWei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyowei/sweep-node-modules.git"
  },
  "homepage": "https://github.com/iyowei/sweep-node-modules#readme",
  "bugs": {
    "url": "https://github.com/iyowei/sweep-node-modules/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "safe-install": "bun scripts/safe-install.ts",
    "prepare": "node scripts/install-git-hooks.mjs || exit 0",
    "build": "turbo run build",
    "verify:release": "bun packages/cli/scripts/verify-release.ts",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "test": "turbo run test",
    "bench": "bun packages/api/bench/run.ts",
    "conformance": "bun packages/cli/scripts/transcription/run-conformance.ts"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/bun": "1.4.2",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "7.0.2"
  }
}
