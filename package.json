{
  "name": "sweep-node-modules",
  "private": true,
  "packageManager": "bun@1.4.2",
  "author": "iTonyYo (https://github.com/iTonyYo)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "multi-release": {
    "ignorePackages": []
  },
  "scripts": {
    "safe-install": "bun scripts/safe-install.ts",
    "prepare": "node scripts/install-git-hooks.mjs || exit 0",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "test": "turbo run test",
    "bench": "bun packages/sweep-node-modules/bench/run.ts",
    "conformance": "bun scripts/transcription/run-conformance.ts",
    "ci": "bun scripts/ci.ts"
  },
  "devDependencies": {
    "@lidofinance/multi-semantic-release": "1.0.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/bun": "1.4.2",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "semantic-release": "25.0.9",
    "turbo": "2.11.5",
    "typescript": "7.0.2"
  }
}
